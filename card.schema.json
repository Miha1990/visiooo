{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:business-card:content:v1",
  "title": "Содержимое электронной визитки",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "template",
    "accent",
    "links"
  ],
  "properties": {
    "layout":{"type":"object","additionalProperties":false,"properties":{
      "avatarOverlap":{"type":"integer","minimum":0,"maximum":100},
      "avatarX":{"type":"integer","minimum":0,"maximum":100},
      "order":{"type":"array","maxItems":13,"uniqueItems":true,"items":{"enum":["cover","avatar","identity","bio","save","business","contacts","socials","carousel","video","document","map","daisy"]}},
      "buttonOrder":{"type":"array","maxItems":30,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":29}},
      "blocks":{"type":"object","additionalProperties":false,"properties":{"cover":{"$ref":"#/$defs/size"},"logo":{"$ref":"#/$defs/size"},"avatar":{"$ref":"#/$defs/size"},"identity":{"$ref":"#/$defs/size"},"bio":{"$ref":"#/$defs/size"},"save":{"$ref":"#/$defs/size"},"business":{"$ref":"#/$defs/size"},"contacts":{"$ref":"#/$defs/size"},"socials":{"$ref":"#/$defs/size"},"carousel":{"$ref":"#/$defs/size"},"video":{"$ref":"#/$defs/size"},"document":{"$ref":"#/$defs/size"},"map":{"$ref":"#/$defs/size"},"daisy":{"$ref":"#/$defs/size"}}},
      "buttons":{"type":"object","maxProperties":30,"additionalProperties":false,"patternProperties":{"^(?:[0-9]|[12][0-9])$":{"$ref":"#/$defs/size"}}},
      "carousel":{"type":"object","additionalProperties":false,"properties":{"visible":{"enum":[1,1.5,2,2.5,3,4]},"height":{"type":"integer","minimum":80,"maximum":640},"fit":{"enum":["cover","contain"]},"aspect":{"enum":["custom","landscape","square","portrait"]}}}
    }},
    "daisy":{"type":"object","additionalProperties":false,"required":["label","items"],"properties":{"label":{"type":"string","minLength":1,"maxLength":40},"items":{"type":"array","maxItems":8,"items":{"$ref":"#/properties/buttons/items"}}}},
    "motion": {"type":"boolean"},
    "business": {"type":"object","additionalProperties":false,"required":["status","timezone","hours"],"properties":{
      "status":{"type":"string","maxLength":120},
      "timezone":{"enum":["Europe/Kaliningrad","Europe/Moscow","Europe/Samara","Asia/Yekaterinburg","Asia/Omsk","Asia/Krasnoyarsk","Asia/Irkutsk","Asia/Yakutsk","Asia/Vladivostok","Asia/Magadan","Asia/Kamchatka"]},
      "hours":{"type":"array","maxItems":7,"items":{"type":"object","additionalProperties":false,"required":["day","open","close"],"properties":{"day":{"type":"integer","minimum":0,"maximum":6},"open":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},"close":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"}}}}
    }},
    "primaryAction":{"type":"object","additionalProperties":false,"required":["kind","label","target"],"properties":{"kind":{"enum":["phone","booking","message"]},"label":{"type":"string","minLength":1,"maxLength":60},"target":{"type":"string","minLength":1,"maxLength":2048}}},
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "company": {
      "type": "string",
      "maxLength": 160
    },
    "bio": {
      "type": "string",
      "maxLength": 1000
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "phoneLabel": {"type": "string", "minLength": 1, "maxLength": 80},
    "logoAssetId": {"type":"string","format":"uuid"},
    "buttonLayout": {"enum":["tiles"]},
    "buttons": {"type":"array","maxItems":30,"items":{"type":"object","additionalProperties":false,"required":["kind","label","value"],"properties":{"kind":{"type":"string","maxLength":30},"label":{"type":"string","minLength":1,"maxLength":80},"value":{"type":"string","maxLength":2048},"extension":{"type":"string","pattern":"^[0-9]{1,8}$"}}}},
    "emailLabel": {"type": "string", "minLength": 1, "maxLength": 80},
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "avatarAssetId": {
      "type": "string",
      "format": "uuid"
    },
    "backgroundAssetId": {
      "type": "string",
      "format": "uuid"
    },
    "headerAssetId": {
      "type": "string",
      "format": "uuid"
    },
    "socials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagram": {
          "$ref": "#/$defs/socialUrl"
        },
        "threads": {
          "$ref": "#/$defs/socialUrl"
        },
        "telegram": {
          "$ref": "#/$defs/socialUrl"
        },
        "vk": {
          "$ref": "#/$defs/socialUrl"
        },
        "ok": {
          "$ref": "#/$defs/socialUrl"
        },
        "max": {
          "$ref": "#/$defs/socialUrl"
        },
        "avito": {
          "$ref": "#/$defs/socialUrl"
        }
      }
    },
    "template": {
      "enum": [
        "classic",
        "minimal",
        "profile"
      ]
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "links": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 2048
          }
        }
      }
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "galleryAssetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "videos": {
      "type": "array", "maxItems": 20,
      "items": {"$ref": "#/$defs/videoItem"}
    },
    "video": {"$ref": "#/$defs/videoItem"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  },
  "$defs": {
    "videoItem": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "maxLength": 2048},
        "embedUrl": {"type": "string", "maxLength": 2048},
        "title": {"type": "string", "maxLength": 100}
      }
    },
    "size":{"type":"object","additionalProperties":false,"properties":{"width":{"enum":[25,33,50,66,75,100]},"height":{"type":"integer","minimum":0,"maximum":720},"radius":{"type":"integer","minimum":0,"maximum":180},"shape":{"enum":["auto","square","circle"]}}},
    "socialUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font",
        "align",
        "buttonShape",
        "buttonStyle",
        "iconPosition",
        "avatarShape",
        "socialMode",
        "buttonColumns",
        "iconSize",
        "avatarSize",
        "coverHeight",
        "gap",
        "radius",
        "nameSize",
        "accent",
        "background",
        "text",
        "caption",
        "saveLabel",
        "phoneLabel",
        "emailLabel",
        "socialLabel",
        "allowAccent",
        "allowFont",
        "weight",
        "blocks",
        "hidden",
        "icons"
      ],
      "properties": {
        "font": {
          "enum": [
            "ui",
            "serif",
            "rounded"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center"
          ]
        },
        "buttonShape": {
          "enum": [
            "rect",
            "rounded",
            "pill"
          ]
        },
        "buttonStyle": {
          "enum": [
            "filled",
            "outline"
          ]
        },
        "iconPosition": {
          "enum": [
            "left",
            "right",
            "top"
          ]
        },
        "avatarShape": {
          "enum": [
            "circle",
            "rounded",
            "square"
          ]
        },
        "socialMode": {
          "enum": [
            "both",
            "icons",
            "radial"
          ]
        },
        "buttonColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "iconSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 36
        },
        "avatarSize": {
          "type": "integer",
          "minimum": 64,
          "maximum": 144
        },
        "coverHeight": {
          "type": "integer",
          "minimum": 60,
          "maximum": 240
        },
        "gap": {
          "type": "integer",
          "minimum": 8,
          "maximum": 32
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "nameSize": {
          "type": "integer",
          "minimum": 22,
          "maximum": 40
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "caption": {
          "type": "string",
          "maxLength": 60
        },
        "saveLabel": {
          "type": "string",
          "maxLength": 60
        },
        "presetStyle":{"enum":["forma","frame","estate"]},
        "phoneLabel": {
          "type": "string",
          "maxLength": 60
        },
        "emailLabel": {
          "type": "string",
          "maxLength": 60
        },
        "socialLabel": {
          "type": "string",
          "maxLength": 60
        },
        "allowAccent": {
          "type": "boolean"
        },
        "allowFont": {
          "type": "boolean"
        },
        "weight": {
          "enum": [
            400,
            600,
            700
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "enum": [
              "cover",
              "avatar",
              "identity",
              "bio",
              "save",
              "contacts",
              "socials",
              "carousel",
              "video",
              "document",
              "map"
            ]
          },
          "minItems": 7,
          "maxItems": 11,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "cover"
              }
            },
            {
              "contains": {
                "const": "avatar"
              }
            },
            {
              "contains": {
                "const": "identity"
              }
            },
            {
              "contains": {
                "const": "bio"
              }
            },
            {
              "contains": {
                "const": "save"
              }
            },
            {
              "contains": {
                "const": "contacts"
              }
            },
            {
              "contains": {
                "const": "socials"
              }
            }
          ]
        },
        "hidden": {
          "type": "array",
          "items": {
            "enum": [
              "cover",
              "avatar",
              "bio",
              "contacts",
              "socials",
              "carousel",
              "video",
              "document",
              "map"
            ]
          },
          "maxItems": 9,
          "uniqueItems": true
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "save": {
              "type": "string",
              "format": "uuid"
            },
            "phone": {
              "type": "string",
              "format": "uuid"
            },
            "email": {
              "type": "string",
              "format": "uuid"
            },
            "link": {
              "type": "string",
              "format": "uuid"
            },
            "telegram": {
              "type": "string",
              "format": "uuid"
            },
            "vk": {
              "type": "string",
              "format": "uuid"
            },
            "ok": {
              "type": "string",
              "format": "uuid"
            },
            "max": {
              "type": "string",
              "format": "uuid"
            },
            "instagram": {
              "type": "string",
              "format": "uuid"
            },
            "threads": {
              "type": "string",
              "format": "uuid"
            },
            "avito": {
              "type": "string",
              "format": "uuid"
            },
            "website": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "sourceName": {
          "type": "string",
          "maxLength": 100
        },
        "blockStyles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cover": {
              "$ref": "#/$defs/blockStyle"
            },
            "avatar": {
              "$ref": "#/$defs/blockStyle"
            },
            "identity": {
              "$ref": "#/$defs/blockStyle"
            },
            "bio": {
              "$ref": "#/$defs/blockStyle"
            },
            "save": {
              "$ref": "#/$defs/blockStyle"
            },
            "contacts": {
              "$ref": "#/$defs/blockStyle"
            },
            "socials": {
              "$ref": "#/$defs/blockStyle"
            },
            "carousel": {
              "$ref": "#/$defs/blockStyle"
            },
            "video": {
              "$ref": "#/$defs/blockStyle"
            },
            "document": {
              "$ref": "#/$defs/blockStyle"
            },
            "map": {
              "$ref": "#/$defs/blockStyle"
            }
          }
        },
        "buttonCorners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "height"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 4000
            }
          }
        },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cover": {
              "$ref": "#/$defs/frame"
            },
            "avatar": {
              "$ref": "#/$defs/frame"
            },
            "identity": {
              "$ref": "#/$defs/frame"
            },
            "bio": {
              "$ref": "#/$defs/frame"
            },
            "save": {
              "$ref": "#/$defs/frame"
            },
            "contacts": {
              "$ref": "#/$defs/frame"
            },
            "socials": {
              "$ref": "#/$defs/frame"
            },
            "carousel": {
              "$ref": "#/$defs/frame"
            },
            "video": {
              "$ref": "#/$defs/frame"
            },
            "document": {
              "$ref": "#/$defs/frame"
            },
            "map": {
              "$ref": "#/$defs/frame"
            }
          }
        },
        "carousel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "photos",
            "visible",
            "height",
            "autoplay",
            "interval"
          ],
          "properties": {
            "photos": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "visible": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "height": {
              "type": "integer",
              "minimum": 80,
              "maximum": 600
            },
            "autoplay": {
              "type": "boolean"
            },
            "interval": {
              "type": "integer",
              "minimum": 2,
              "maximum": 120
            },
            "title": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "avatar": {
              "type": "string",
              "format": "uuid"
            },
            "header": {
              "type": "string",
              "format": "uuid"
            },
            "background": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "blockStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "align",
        "iconPosition"
      ],
      "properties": {
        "align": {
          "enum": [
            "inherit",
            "left",
            "center",
            "right"
          ]
        },
        "iconPosition": {
          "enum": [
            "inherit",
            "left",
            "right",
            "top",
            "none"
          ]
        },
        "iconSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 36
        },
        "icon": {
          "type": "string",
          "format": "uuid"
        },
        "buttonShape": {
          "enum": [
            "inherit",
            "rect",
            "rounded",
            "pill",
            "circle"
          ]
        },
        "buttonCorners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "unit",
        "height",
        "z",
        "corners"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 4000
        },
        "width": {
          "type": "number",
          "minimum": 8,
          "maximum": 720
        },
        "unit": {
          "enum": [
            "%",
            "px"
          ]
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "corners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "name": "Анна Иванова",
      "title": "Дизайнер",
      "template": "minimal",
      "accent": "#2457DB",
      "links": []
    }
  ],
  "$comment": "Включать format validation явно. Пустые необязательные поля редактор удаляет. Владение изображением, лимиты, контраст цвета и нормализация проверяются сервером отдельно. Это содержимое, не полный объект Card."
}
