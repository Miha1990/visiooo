server {
    listen 80;
    server_name mail.visiooo.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/myqr-acme; }
    location / { return 301 https://mail.visiooo.ru$request_uri; }
}
server {
    listen 443 ssl;
    server_name mail.visiooo.ru;
    ssl_certificate /etc/letsencrypt/live/mail.visiooo.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mail.visiooo.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
