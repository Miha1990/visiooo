[Unit]
Description=Renew only myQR-managed certificates
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/myQR
EnvironmentFile=/opt/myQR/app/.env
ExecStart=/opt/myQR/.venv/bin/python /opt/myQR/app/manage.py process_domains --renew
TimeoutStartSec=7200
PrivateTmp=true
NoNewPrivileges=true
