# Заменяет только начальную конфигурацию visiooo.ru после выпуска сертификата.
# Не устанавливать одновременно с visiooo-http.conf.example.
server {
    listen 80;
    server_name visiooo.ru;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/myqr-acme;
        default_type text/plain;
    }
    location / {
        return 301 https://visiooo.ru$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name visiooo.ru;
    ssl_certificate /etc/letsencrypt/live/visiooo.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/visiooo.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 60m;

    # Загруженные изображения выдаются только через проверяющие доступ маршруты Django.
    # Не публиковать private-media и не добавлять для него alias/root.
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
