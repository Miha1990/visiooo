# Конфигурация публичного сервера. Скопировать на сервер в app/.env и заполнить пустые поля.
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=
DATABASE_URL=
POSTGRES_DB=visiooo
POSTGRES_USER=visiooo
POSTGRES_PASSWORD=
ALLOWED_HOSTS=visiooo.ru
PUBLIC_BASE_URL=https://visiooo.ru
# Внешний доступ к приложению закрыт; запросы принимает только собственный Nginx.
TRUST_PROXY=true
WEB_PORT=18081
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=m@ros100.ru
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
OPERATOR_INN=615308640848
OPERATOR_ADDRESS=г. Ростов-на-Дону, ул. Зорге, д. 27, кв. 30
DATA_HOSTING_PROVIDER=
DATA_MAIL_PROVIDER=
LEGAL_LAUNCH_CONFIRMED=false
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=false
NPD_RECEIPTS_CONFIRMED=false
# Пользовательские домены включаются после установки отдельного обработчика из ops/DOMAINS.md.
CUSTOM_DOMAINS_ENABLED=false
DOMAIN_IPV4=31.192.110.184
DOMAIN_ACME_EMAIL=m@ros100.ru
DOMAIN_UPSTREAM_PORT=18081
